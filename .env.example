# ARCHIVE 环境变量模板
# 复制为 .env.local 后填写；此文件只能保留占位值，禁止写入真实 Key。

# ———— 数据库 ————
# LOCAL（默认）：SQLite 文件相对 prisma/ 解析；不写即使用 app.db。
# DATABASE_URL="file:./app.db"

# HOSTED（可选）：libSQL / Turso。
# DATABASE_MODE="HOSTED"
# LIBSQL_URL="libsql://<your-db>.turso.io"
# LIBSQL_AUTH_TOKEN="<your-libsql-token>"

# ———— 身份 ————
# 本地默认 Owner 密码为 archive-owner；长期使用或托管时必须修改。
# OWNER_PASSWORD="<your-owner-password>"
# 本地默认 Visitor 访问码为 interview。
# VISITOR_ACCESS_CODE="<your-visitor-code>"
# 兼容旧部署变量名：DEMO_ACCESS_CODE 的值也会被读取，但新配置请使用 VISITOR_ACCESS_CODE。
# SESSION_SECRET="<at-least-16-random-characters>"

# ———— 图片识别：Kimi K2.6 ————
# MOONSHOT_API_KEY="<your-moonshot-key>"
# KIMI_MODEL="kimi-k2.6"
# KIMI_BASE_URL="https://api.moonshot.cn/v1"

# ———— 收藏建议：DeepSeek V4 Flash ————
# DEEPSEEK_API_KEY="<your-deepseek-key>"
# DEEPSEEK_MODEL="deepseek-v4-flash"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ———— 可选兼容适配器 ————
# 仅当你有实现相同契约的外部识别服务时使用；优先级高于 Kimi。
# RECOGNITION_API_URL="<your-compatible-endpoint>"
# RECOGNITION_API_KEY="<your-compatible-key>"

# ———— 服务端口 ————
# PORT=3000
